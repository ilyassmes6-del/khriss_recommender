{% comment %}
  khriss AI recommender — theme app block.

  Merchants drop this block onto any page in the theme editor and set the API
  base URL (the deployed khriss service). The block renders an upload widget
  with a client-side preview; results come back from POST {api}/recommend.

  Copy lives here rather than in the JS so it stays editable in the theme
  editor and translatable per storefront. Prices are formatted from the shop's
  own money_format, so the widget shows dirhams where the rest of the store
  does, instead of a hardcoded currency.
{% endcomment %}

<div
  class="khriss"
  data-khriss-api="{{ block.settings.api_url }}"
  data-khriss-money="{{ shop.money_format | strip_html | escape }}"
  data-khriss-t-analysing="{{ 'Analyse de votre photo…' | escape }}"
  data-khriss-t-outfit="{{ 'Pour compléter votre look :' | escape }}"
  data-khriss-t-similar="{{ 'Articles similaires :' | escape }}"
  data-khriss-t-both="{{ 'Voici les deux, au choix :' | escape }}"
  data-khriss-t-empty="{{ 'Aucun résultat pour cette photo. Essayez une autre prise de vue.' | escape }}"
  data-khriss-t-error="{{ 'Une erreur est survenue. Veuillez réessayer.' | escape }}"
  data-khriss-t-add="{{ 'Ajouter au panier' | escape }}"
  data-khriss-t-adding="{{ 'Ajout…' | escape }}"
  data-khriss-t-added="{{ 'Ajouté ✓' | escape }}"
  data-khriss-t-retry="{{ 'Réessayer' | escape }}"
>
  <div class="khriss__intro">
    <h2 class="khriss__heading">{{ block.settings.heading }}</h2>
    <p class="khriss__sub">{{ block.settings.subheading }}</p>
  </div>

  <label class="khriss__drop" tabindex="0">
    <input type="file" accept="image/*" class="khriss__file" hidden />
    <svg class="khriss__drop-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 16V4m0 0L8 8m4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <span class="khriss__drop-btn">{{ block.settings.button_label }}</span>
    <span class="khriss__drop-hint">{{ block.settings.hint }}</span>
  </label>

  <div class="khriss__preview" hidden>
    {% comment %}
      width/height are a 1:1 placeholder ratio only: the real dimensions come
      from the file the shopper picks. CSS resets both to auto, so these just
      reserve space before load and satisfy theme-check.
    {% endcomment %}
    <img class="khriss__preview-img" alt="Votre photo" width="200" height="200" />
  </div>

  <p class="khriss__status" hidden></p>

  {% comment %} Tabs appear only when detection is ambiguous. {% endcomment %}
  <div class="khriss__tabs" role="tablist" hidden>
    <button type="button" class="khriss__tab is-active" data-tab="outfit" role="tab">Compléter le look</button>
    <button type="button" class="khriss__tab" data-tab="shoe" role="tab">Articles similaires</button>
  </div>

  <div class="khriss__results" role="list"></div>
</div>

<script src="{{ 'recommender.js' | asset_url }}" defer></script>
{{ 'recommender.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "khriss recommender",
  "target": "section",
  "settings": [
    {
      "type": "url",
      "id": "api_url",
      "label": "URL de l'API khriss",
      "info": "ex. https://votre-service.up.railway.app (sans barre oblique finale)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Trouvez votre style"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Envoyez la photo d'une tenue ou d'un article, on s'occupe du reste."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Choisir une photo"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Texte d'aide",
      "default": "JPG ou PNG, 5 Mo maximum"
    }
  ]
}
{% endschema %}
