# ---------------------------------------------------------------------------
# Shopify Admin API
# ---------------------------------------------------------------------------
# Your store's myshopify domain, without protocol, e.g. my-shoes.myshopify.com
SHOPIFY_SHOP=maisonmasilya.myshopify.com
# Dev Dashboard app credentials (app > Parametres > Identifiants). These are
# exchanged for a 24h Admin API token at runtime -- there is no token to paste.
# Publish read_products under "Champs d'acces" or the token is denied everything.
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
# Legacy custom apps only (retired Jan 2026): a permanent shpat_ token, which
# overrides the exchange above. Leave blank unless you already have one.
SHOPIFY_ADMIN_TOKEN=
# Admin API version. Bump quarterly; 2024-04 is a safe recent default.
SHOPIFY_API_VERSION=2026-07
# Shared secret used to verify products/update webhook HMAC signatures.
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret

# ---------------------------------------------------------------------------
# OpenRouter (LLM provider: Mode A ranking, and optionally vision extraction)
# ---------------------------------------------------------------------------
# OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# OpenAI-compatible base URL (leave as default unless self-hosting a proxy).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers.
OPENROUTER_REFERER=https://maisonmasilya.myshopify.com
OPENROUTER_TITLE=khriss
# OpenRouter model slug for the single Mode A ranking call.
RANKER_MODEL=anthropic/claude-haiku-4.5
# Optional separate slug for the vision extractor; blank -> reuse RANKER_MODEL.
VISION_MODEL=

# ---------------------------------------------------------------------------
# Attribute extractor selection
# ---------------------------------------------------------------------------
# clip -> zero-shot CLIP, no API cost (default)
# llm  -> OpenRouter vision (Claude Haiku 4.5), ~$0.001/image, higher fidelity
EXTRACTOR=clip

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
DATABASE_URL=postgresql+psycopg://khriss:khriss@postgres:5432/khriss

# ---------------------------------------------------------------------------
# Serving / behaviour knobs
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (your storefront domain(s)).
ALLOWED_ORIGINS=https://your-store.myshopify.com,https://your-store.com
# If |P(shoe) - P(outfit)| is below this, return BOTH modes (tabs on storefront).
MODE_CONFIDENCE_THRESHOLD=0.10
